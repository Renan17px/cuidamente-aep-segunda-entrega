# Porta da API
PORT=3333

# Conexão com o MySQL
# Use 127.0.0.1 (no Windows, "localhost" pode ser resolvido como IPv6 ::1 e o MySQL recusar)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cuidamente

# Segredo usado para assinar os tokens de login (troque por um valor longo e aleatório)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h
